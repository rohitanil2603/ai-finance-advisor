# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL via Prisma). DIRECT_URL is used only by `prisma migrate` — if your
# provider pools connections (Neon, Supabase, PgBouncer), set it to the *unpooled* connection
# string; migrations can hang indefinitely against a pooled URL. For a plain local Postgres
# with no pooler, DIRECT_URL can just be the same value as DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_advisor
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/finance_advisor

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=fa_session

# LLM (OpenRouter - https://openrouter.ai/keys). Default model is free (no credits needed) and
# supports structured JSON output, which insights.service.ts relies on. Swap for a paid model
# (e.g. anthropic/claude-3.5-haiku) for better quality if you have OpenRouter credits.
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=ai-finance-advisor

# Upload limits
MAX_UPLOAD_SIZE_MB=5
